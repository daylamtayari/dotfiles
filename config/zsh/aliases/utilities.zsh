# Alternate Utility Aliases

alias cat=bat
alias cd=z
alias df=duf
alias du=dust
alias grep="grep --color=auto"
alias htop=btm
alias lg="exa -lg --git --icons auto"
alias lga="exa -lga --git --icons auto"
alias ll="exa --long --git --icons auto"
alias lla="exa --long -a --git --icons auto"
alias lr="exa --recurse --icons auto"
alias ls="exa --icons auto"
alias lsa="exa -a --icons auto"
alias ping=gping
alias ps=procs
alias top=btop
alias tree="exa --tree --icons"
alias vim=nvim
