{
  "$schema": "https://opencode.ai/config.json",
  "shell": "zsh",
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "question": "allow"
  },
  "share": "disabled",
  "autoupdate": false,
  "formatter": true,
  "lsp": true,
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "wiz": {
      "type": "remote",
      "url": "https://mcp.app.wiz.io",
      "enabled": true
    },
    "panther": {
      "type": "local",
      "command": ["sh", "-c", "PANTHER_INSTANCE_URL=\"$(op read 'op://Employee/Panther API Key/website')\" PANTHER_API_TOKEN=\"$(op read 'op://Employee/Panther API Key/password')\" exec docker run -i -e PANTHER_INSTANCE_URL -e PANTHER_API_TOKEN --rm ghcr.io/panther-labs/mcp-panther"],
      "enabled": true
    },
    "crowdstrike": {
      "type": "local",
      "command": ["sh", "-c", "FALCON_CLIENT_ID=\"$(op read 'op://Employee/Falcon MCP/username')\" FALCON_CLIENT_SECRET=\"$(op read 'op://Employee/Falcon MCP/password')\" FALCON_BASE_URL=\"$(op read 'op://Employee/Falcon MCP/website')\" exec \"$HOME/.pyenv/versions/crowdstrike-mcp/bin/falcon-mcp\""],
      "enabled": true
    },
    "burp": {
      "type": "remote",
      "url": "http://127.0.0.1:9876",
      "enabled": true
    },
    "nvim": {
      "type": "local",
      "command": ["nvim-mcp", "--connect", "auto"],
      "enabled": true
    }
  }
}
